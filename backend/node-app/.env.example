# Rappi AI Purchasing Agent — Node.js backend configuration
# Copy this file to .env and fill in real values. 

# MongoDB connection URL (local or Atlas)
MONGO_URL=mongodb://localhost:27017
DB_NAME=rappi_purchasing_agent

# Port the Node.js Express server listens on
NODE_PORT=5001

# LLM configuration — Emergent Universal Key OR your own Gemini key
# When using the Emergent Universal Key, the backend calls Emergent's LiteLLM proxy.
EMERGENT_LLM_KEY=sk-your-emergent-key-here
INTEGRATION_PROXY_URL=https://integrations.emergentagent.com
LLM_MODEL=gemini-2.5-flash
LLM_PROVIDER=gemini

# If true, skip the LLM and always use the deterministic rule-based agent.
AGENT_FORCE_FALLBACK=false
